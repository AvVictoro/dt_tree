{
  "cleanUrls": false,
  "functions": {
    "api/catalog/[...route].mjs": {
      "includeFiles": "catalog/demo/catalog-demo.json",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/datatracker-agent-v6.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
